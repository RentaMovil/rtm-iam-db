# Copy to .env (never commit .env). Used by docker-compose.yml.
# SA password must meet SQL Server complexity rules: 8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=ChangeMe_Local123!
MSSQL_PORT=1433
MSSQL_DATABASE=rentamovil

# Password for the iam_app user, used by the "migrations" container (03_dcl).
# Must be the same value as parameter.iamAppPassword in liquibase.properties
# and DATABASE_PASSWORD in rtm-iam/.env
IAM_APP_PASSWORD=ChangeMe_IamApp123!
